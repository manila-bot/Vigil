# Copy to .env (never commit .env). Export these before running uvicorn.
VIGIL_ADMIN_EMAIL=admin@vigil.local
VIGIL_ADMIN_PASSWORD=
VIGIL_RESPONDER_PASSWORD=
VIGIL_TZ=America/Chicago
# Lovable preview URL(s) allowed to call the API during development, comma-separated
VIGIL_CORS_ORIGINS=
# External providers: off by default. Core features never depend on them.
VIGIL_NEMOTRON_ENABLED=0
NVIDIA_API_KEY=
VIGIL_PHOTON_ENABLED=0
PHOTON_API_KEY=
# Nemotron model + endpoint (OpenAI-compatible). Defaults shown.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_TIMEOUT=60
