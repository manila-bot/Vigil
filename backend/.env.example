# Copy to .env (never commit .env). Export these before running uvicorn.
VIGIL_ADMIN_EMAIL=admin@vigil.local
VIGIL_ADMIN_PASSWORD=
VIGIL_RESPONDER_PASSWORD=
VIGIL_TZ=America/Chicago
# Lovable preview URL(s) allowed to call the API during development, comma-separated
VIGIL_CORS_ORIGINS=
# External providers: off by default. Core features never depend on them.
VIGIL_NEMOTRON_ENABLED=0
NVIDIA_API_KEY=
VIGIL_PHOTON_ENABLED=0
PHOTON_API_KEY=
# Which service hosts Nemotron: nvidia (uses NVIDIA_API_KEY) or openrouter (uses OPENROUTER_API_KEY).
# Base URL and model default per provider; set NEMOTRON_BASE_URL / NEMOTRON_MODEL only to override.
NEMOTRON_PROVIDER=nvidia
OPENROUTER_API_KEY=
NEMOTRON_TIMEOUT=60
PHOTON_PROJECT_ID=
PHOTON_TEST_SENDER=
PHOTON_AGENT_HANDLE=
PHOTON_PLATFORM=imessage
PHOTON_SPACE_ID=
PHOTON_AGENT_USER_ID=
PHOTON_WEBHOOK_SECRET=
