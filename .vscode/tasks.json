{
  // Terminal → Run Task… → "Vigil: run app" starts the FastAPI backend and the Lovable frontend together.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vigil: backend",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": { "pattern": { "regexp": "^x^" }, "background": { "beginsPattern": "Will watch|Started", "endsPattern": "Uvicorn running" } },
      "presentation": { "group": "vigil", "panel": "dedicated" }
    },
    {
      "label": "Vigil: frontend-new",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend-new" },
      "isBackground": true,
      "problemMatcher": { "pattern": { "regexp": "^x^" }, "background": { "beginsPattern": "VITE", "endsPattern": "Local:" } },
      "presentation": { "group": "vigil", "panel": "dedicated" }
    },
    {
      "label": "Vigil: run app",
      "dependsOn": ["Vigil: backend", "Vigil: frontend-new"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
